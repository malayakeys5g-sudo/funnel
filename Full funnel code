🧩 8. app/waitlist/page.js

"use client";

import { useState } from "react";

export default function WaitlistPage() {
  const [email, setEmail] = useState("");
  const [submitted, setSubmitted] = useState(false);

  async function submitEmail() {
    await fetch("/api/waitlist", {
      method: "POST",
      body: JSON.stringify({ email })
    });

    setSubmitted(true);
  }

  return (
    <main className="p-10 text-center">
      <h1 className="text-3xl font-bold mb-4">Join the Waitlist</h1>

      {!submitted ? (
        <>
          <input
            type="email"
            placeholder="Your email"
            className="p-3 rounded-md text-black w-64"
            onChange={(e) => setEmail(e.target.value)}
          />

          <button
            onClick={submitEmail}
            className="block mx-auto mt-4 px-6 py-3 bg-white text-black rounded-md font-semibold"
          >
            Submit
          </button>
        </>
      ) : (
        <p className="text-xl mt-6">You're on the list.</p>
      )}
    </main>
  );
}


